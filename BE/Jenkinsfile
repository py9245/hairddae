pipeline {
  agent any

  options {
    timestamps()
    disableConcurrentBuilds()
  }

  environment {
    APP_IMAGE = 'be-app:local'
    DEPLOY_ROOT = '/home/ubuntu/S14P21M101/BE'
    STATIC_ROOT = '/home/ubuntu/S14P21M101/static'
    COMPOSE_FILE = '/home/ubuntu/S14P21M101/BE/docker-compose.yml'
  }

  stages {
    stage('Checkout') {
      steps {
        checkout scm
      }
    }

    stage('Run Tests') {
      steps {
        sh '''
          set -eu
          docker run --rm \
            -v "$WORKSPACE/BE:/workspace" \
            -w /workspace \
            eclipse-temurin:21-jdk \
            bash -lc './gradlew test'
        '''
      }
    }

    stage('Build Images') {
      steps {
        sh '''
          set -eu
          docker build -t "$APP_IMAGE" -f "$WORKSPACE/BE/Dockerfile" "$WORKSPACE/BE"
        '''
      }
    }

    stage('Sync Deploy Files') {
      steps {
        sh '''
          set -eu
          mkdir -p "$DEPLOY_ROOT/nginx"
          cp -f "$WORKSPACE/BE/docker-compose.yml" "$COMPOSE_FILE"
          cp -f "$WORKSPACE/BE/nginx/default.conf" "$DEPLOY_ROOT/nginx/default.conf"
        '''
      }
    }

    stage('Verify Static Dataset') {
      steps {
        sh '''
          set -eu
          test -d "$STATIC_ROOT"
          test -f "$STATIC_ROOT/0001/manifests/asset_index_v0.json"
          test -d "$STATIC_ROOT/0001/hair_rgba"
        '''
      }
    }

    stage('Deploy With Compose') {
      steps {
        sh '''
          set -eu
          test -f "$COMPOSE_FILE"
          docker compose -f "$COMPOSE_FILE" config >/dev/null

          wait_for_service_health() {
            service_name="$1"
            container_id="$(docker compose -f "$COMPOSE_FILE" ps -q "$service_name")"
            if [ -z "$container_id" ]; then
              echo "container not found for service: $service_name"
              exit 1
            fi

            for i in $(seq 1 30); do
              status="$(docker inspect --format='{{if .State.Health}}{{.State.Health.Status}}{{else}}{{.State.Status}}{{end}}' "$container_id" 2>/dev/null || true)"
              if [ "$status" = "healthy" ]; then
                return 0
              fi
              sleep 2
            done

            echo "service did not become healthy: $service_name"
            docker compose -f "$COMPOSE_FILE" logs "$service_name" --tail 100 || true
            exit 1
          }

          docker compose -f "$COMPOSE_FILE" up -d postgres redis
          wait_for_service_health postgres
          wait_for_service_health redis
          docker compose -f "$COMPOSE_FILE" up -d --no-deps app
          docker compose -f "$COMPOSE_FILE" up -d --no-deps --force-recreate --remove-orphans nginx
        '''
      }
    }

    stage('Health Check') {
      steps {
        sh '''
          set -eu

          if [ -f "$DEPLOY_ROOT/.env" ]; then
            set -a
            . "$DEPLOY_ROOT/.env"
            set +a
          fi

          PUBLIC_HOST="${APP_PUBLIC_PRIMARY_HOST:-hairddae.store}"

          rtc_offer_headers() {
            rtc_headers_file="$(mktemp)"
            curl -sS -o /dev/null -D "$rtc_headers_file" \
              --connect-timeout 2 \
              --max-time 2 \
              --resolve "$PUBLIC_HOST:443:127.0.0.1" \
              -X POST \
              -H 'Content-Type: application/json' \
              --data '{}' \
              "https://$PUBLIC_HOST/rtc/inference/offer" >/dev/null 2>&1 || true
            tr -d '\r' < "$rtc_headers_file"
            rm -f "$rtc_headers_file"
          }

          static_manifest_headers() {
            curl -fsSI \
              --resolve "$PUBLIC_HOST:443:127.0.0.1" \
              "https://$PUBLIC_HOST/static/0001/manifests/asset_index_v0.json" | tr -d '\r'
          }

          static_image_headers() {
            curl -fsSI \
              --resolve "$PUBLIC_HOST:443:127.0.0.1" \
              "https://$PUBLIC_HOST/static/0001/hair_rgba/base_pose_bank__yaw+00_pitch+01_roll-01_frame000922.png" | tr -d '\r'
          }

          inference_health() {
            curl -fsS \
              --resolve "$PUBLIC_HOST:443:127.0.0.1" \
              "https://$PUBLIC_HOST/ws/inference/healthz"
          }

          swagger_headers() {
            curl -fsSIL \
              --resolve "$PUBLIC_HOST:443:127.0.0.1" \
              "https://$PUBLIC_HOST/api/swagger-ui.html" | tr -d '\r'
          }

          openapi_body() {
            curl -fsS \
              --resolve "$PUBLIC_HOST:443:127.0.0.1" \
              "https://$PUBLIC_HOST/api/v3/api-docs"
          }

          normalrank_body() {
            curl -fsS \
              --resolve "$PUBLIC_HOST:443:127.0.0.1" \
              "https://$PUBLIC_HOST/api/home/normalrank"
          }

          categorylist_body() {
            curl -fsS \
              --resolve "$PUBLIC_HOST:443:127.0.0.1" \
              "https://$PUBLIC_HOST/api/home/categorylist"
          }

          dump_diagnostics() {
            docker compose -f "$COMPOSE_FILE" ps || true
            docker compose -f "$COMPOSE_FILE" logs app --tail 200 || true
            docker compose -f "$COMPOSE_FILE" logs nginx --tail 100 || true
            curl -vk --resolve "$PUBLIC_HOST:443:127.0.0.1" \
              "https://$PUBLIC_HOST/api/health" || true
            curl -vk --resolve "$PUBLIC_HOST:443:127.0.0.1" \
              "https://$PUBLIC_HOST/actuator/health" || true
          }

          for i in $(seq 1 40); do
            READY_LABEL=""
            if curl -fsS --resolve "$PUBLIC_HOST:443:127.0.0.1" "https://$PUBLIC_HOST/api/health" >/dev/null 2>&1; then
              READY_LABEL="api"
            elif curl -fsS --resolve "$PUBLIC_HOST:443:127.0.0.1" "https://$PUBLIC_HOST/actuator/health" >/dev/null 2>&1; then
              READY_LABEL="actuator"
            fi

            if [ -n "$READY_LABEL" ]; then
              RTC_OFFER_HEADERS="$(rtc_offer_headers)"
              STATIC_MANIFEST_HEADERS="$(static_manifest_headers)"
              STATIC_IMAGE_HEADERS="$(static_image_headers)"
              SWAGGER_HEADERS="$(swagger_headers)"
              OPENAPI_BODY="$(openapi_body)"
              NORMALRANK_BODY="$(normalrank_body)"
              CATEGORYLIST_BODY="$(categorylist_body)"
              INFERENCE_HEALTH="$(inference_health || true)"

              if printf '%s\n' "$RTC_OFFER_HEADERS" | grep -q '^HTTP/2 422\\|^HTTP/1.1 422' \
                && printf '%s\n' "$STATIC_MANIFEST_HEADERS" | grep -q '^HTTP/2 200\\|^HTTP/1.1 200' \
                && printf '%s\n' "$STATIC_MANIFEST_HEADERS" | grep -Fq 'cache-control: public, max-age=60' \
                && printf '%s\n' "$STATIC_IMAGE_HEADERS" | grep -q '^HTTP/2 200\\|^HTTP/1.1 200' \
                && printf '%s\n' "$STATIC_IMAGE_HEADERS" | grep -Fq 'cache-control: public, max-age=31536000, immutable' \
                && printf '%s\n' "$SWAGGER_HEADERS" | grep -q '^HTTP/2 200\\|^HTTP/1.1 200' \
                && printf '%s\n' "$OPENAPI_BODY" | grep -Fq '/api/home/normalrank' \
                && printf '%s\n' "$OPENAPI_BODY" | grep -Fq '/api/home/categorylist' \
                && printf '%s\n' "$NORMALRANK_BODY" | grep -Fq '"best"' \
                && printf '%s\n' "$NORMALRANK_BODY" | grep -Fq '"latest"' \
                && printf '%s\n' "$CATEGORYLIST_BODY" | grep -Fq '"categoryList"' \
                && printf '%s\n' "$INFERENCE_HEALTH" | grep -Fq '"status":"ok"'; then
                echo "health check passed: $READY_LABEL, rtc-offer-proxy, static-manifest, static-image, swagger, openapi, public-api, inference-health"
                exit 0
              fi
            fi

            echo "health check retry $i/40"
            sleep 3
          done

          echo "health check failed after retries"
          dump_diagnostics
          exit 1
        '''
      }
    }
  }

  post {
    always {
      echo "BE pipeline finished: ${env.JOB_NAME} #${env.BUILD_NUMBER}"
    }
  }
}
