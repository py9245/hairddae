pipeline {
  agent any

  options {
    timestamps()
    disableConcurrentBuilds()
  }

  environment {
    DEPLOY_DIR = '/home/ubuntu/S14P21M101/BE/nginx/html'
  }

  stages {
    stage('Checkout') {
      steps {
        checkout scm
      }
    }

    stage('Build FE') {
      when {
        expression {
          def b = env.BRANCH_NAME ?: env.GIT_BRANCH ?: ''
          return b == 'FE' || b == 'origin/FE' || b.endsWith('/FE')
        }
      }
      steps {
        dir('FE') {
          sh '''
            set -eu

            run_pnpm() {
              if command -v corepack >/dev/null 2>&1; then
                corepack pnpm "$@"
              elif command -v pnpm >/dev/null 2>&1; then
                pnpm "$@"
              elif command -v npx >/dev/null 2>&1; then
                npx -y pnpm@10 "$@"
              else
                echo "ERROR: corepack/pnpm/npx not found." >&2
                exit 1
              fi
            }

            if command -v corepack >/dev/null 2>&1; then
              corepack enable
            fi

            run_pnpm install --frozen-lockfile
            run_pnpm run build
          '''
        }
      }
    }

    stage('Deploy dist') {
      when {
        expression {
          def b = env.BRANCH_NAME ?: env.GIT_BRANCH ?: ''
          return b == 'FE' || b == 'origin/FE' || b.endsWith('/FE')
        }
      }
      steps {
        sh '''
          set -eu
          test -d "$DEPLOY_DIR"
          rsync -av --delete --exclude='.gitkeep' "$WORKSPACE/FE/dist/" "$DEPLOY_DIR/"
        '''
      }
    }

    stage('Smoke Check') {
      when {
        expression {
          def b = env.BRANCH_NAME ?: env.GIT_BRANCH ?: ''
          return b == 'FE' || b == 'origin/FE' || b.endsWith('/FE')
        }
      }
      steps {
        sh '''
          set -eu
          curl -fsS --resolve j14m101.p.ssafy.io:443:127.0.0.1 https://j14m101.p.ssafy.io/ >/dev/null
          curl -fsS --resolve j14m101.p.ssafy.io:443:127.0.0.1 https://j14m101.p.ssafy.io/api/health >/dev/null
        '''
      }
    }
  }

  post {
    always {
      echo "FE pipeline finished: ${env.JOB_NAME} #${env.BUILD_NUMBER}"
    }
  }
}
