pipeline {
  agent any

  options {
    timestamps()
    disableConcurrentBuilds()
  }

  environment {
    DEPLOY_DIR = '/home/ubuntu/S14P21M101/BE/nginx/html'
  }

  stages {
    stage('Checkout') {
      steps {
        checkout scm
      }
    }

    stage('Build FE') {
      when {
        allOf {
          branch 'FE'
          changeset pattern: 'FE/**', comparator: 'ANT'
        }
      }
      steps {
        dir('FE') {
          sh '''
            set -eu
            corepack enable
            corepack pnpm install --frozen-lockfile
            corepack pnpm run build
          '''
        }
      }
    }

    stage('Deploy dist') {
      when {
        allOf {
          branch 'FE'
          changeset pattern: 'FE/**', comparator: 'ANT'
        }
      }
      steps {
        sh '''
          set -eu
          test -d "$DEPLOY_DIR"
          rsync -av --delete --exclude='.gitkeep' "$WORKSPACE/FE/dist/" "$DEPLOY_DIR/"
        '''
      }
    }

    stage('Smoke Check') {
      when {
        allOf {
          branch 'FE'
          changeset pattern: 'FE/**', comparator: 'ANT'
        }
      }
      steps {
        sh '''
          set -eu
          curl -fsS --resolve j14m101.p.ssafy.io:443:127.0.0.1 https://j14m101.p.ssafy.io/ >/dev/null
          curl -fsS --resolve j14m101.p.ssafy.io:443:127.0.0.1 https://j14m101.p.ssafy.io/api/health >/dev/null
        '''
      }
    }
  }

  post {
    always {
      echo "FE pipeline finished: ${env.JOB_NAME} #${env.BUILD_NUMBER}"
    }
  }
}
