# Hairddae GPU inference server env example

INFERENCE_APP_NAME=hairapply-inference
INFERENCE_HOST=0.0.0.0
INFERENCE_PORT=8090
INFERENCE_PUBLIC_IP=replace-with-gpu-public-ip

INFERENCE_NODE_ID=infer-gpu-01
INFERENCE_TICKET_AUDIENCE=inference

APP_SECURITY_JWT_SECRET=replace-with-real-jwt-secret
APP_SECURITY_JWT_ISSUER=hairddae
INFERENCE_TICKET_ALGORITHMS=HS384,HS256

INFERENCE_FEATURE_SCHEMA_VERSION=2
INFERENCE_TRANSFORM_VERSION=affine_v1

INFERENCE_MODEL_ROOT=/srv/hairddae-inference/models
INFERENCE_ASSET_ROOT=/srv/hairddae-inference/assets
INFERENCE_FACE_LANDMARKER_MODEL_PATH=/srv/hairddae-inference/models/face_landmarker.task
INFERENCE_STARTUP_PREWARM_ENABLED=false

INFERENCE_RTC_INPUT_WIDTH=576
INFERENCE_RTC_INPUT_HEIGHT=1024
INFERENCE_RTC_INPUT_FPS=15

INFERENCE_RTC_OUTPUT_WIDTH=576
INFERENCE_RTC_OUTPUT_HEIGHT=1024
INFERENCE_RTC_OUTPUT_FPS=15

INFERENCE_RTC_MIRRORED_INPUT=true
INFERENCE_RTC_OUTPUT_MIRRORED=false
INFERENCE_RTC_RENDERER_NAME=mesh_v3
INFERENCE_RTC_LATENCY_RENDERER_NAME=mesh_v2
INFERENCE_RTC_HAIR_ATTENUATION_ENABLED=true
INFERENCE_RTC_HAIR_ATTENUATION_STRENGTH=0.78
INFERENCE_RTC_HAIR_ATTENUATION_DESATURATION=0.24
INFERENCE_RTC_HAIR_ATTENUATION_BRIGHTNESS_LIFT=0.05
INFERENCE_RTC_HAIR_ATTENUATION_BLUR_KERNEL_SCALE=0.085
INFERENCE_RTC_HAIR_ATTENUATION_MAX_WORK_DIMENSION=176
INFERENCE_RTC_DISABLE_USER_PARSING_IN_LATENCY_MODE=true
INFERENCE_FACE_TRACKER_DELEGATE=gpu
INFERENCE_FACE_TRACKER_NUM_FACES=1

INFERENCE_RTC_START_BITRATE_BPS=1200000
INFERENCE_RTC_MIN_BITRATE_BPS=650000
INFERENCE_RTC_MAX_BITRATE_BPS=1500000
INFERENCE_RTC_MAX_PENDING_FRAMES=1
INFERENCE_RTC_CONTROL_CHANNEL_NAME=control
INFERENCE_RTC_REQUIRE_HELLO=true
INFERENCE_RTC_STATS_INTERVAL_MS=1000
INFERENCE_RTC_SEND_PROCESSED_EVENTS=false
INFERENCE_RTC_PROCESS_MAX_DIMENSION=560
INFERENCE_RTC_PROCESS_MIN_DIMENSION=400
INFERENCE_RTC_PROCESS_STEP_DIMENSION=80
INFERENCE_RTC_ANGLE_PRIORITY_ENABLED=false
INFERENCE_RTC_POSE_SMOOTHING_ENABLED=true
INFERENCE_OUTER_BACKGROUND_RING_PX=5
INFERENCE_RTC_TARGET_FRAME_LATENCY_MS=80
INFERENCE_RTC_ADAPTIVE_SLOW_THRESHOLD_RATIO=1.08
INFERENCE_RTC_ADAPTIVE_FAST_THRESHOLD_RATIO=0.72
INFERENCE_RTC_USER_PARSING_MAX_REUSE_FRAMES=6
INFERENCE_RTC_USER_PARSING_LATENCY_MAX_REUSE_FRAMES=10
INFERENCE_RTC_HAIR_CONTROL_MAP_JSON='[{"hair_id":1,"dataset_code":"0001"}]'

INFERENCE_RTC_ICE_SERVERS_JSON='[]'
INFERENCE_RTC_INTERNAL_ICE_SERVERS_JSON='[]'

INFERENCE_HTTP_TEST_ENABLED=false
INFERENCE_HTTP_TEST_DEFAULT_DATASET_CODE=0001
INFERENCE_HTTP_TEST_JPEG_QUALITY=88
