# Required for ticket validation. In same-server deploy these should match BE.
APP_SECURITY_JWT_SECRET=change-me-for-real-deploy
APP_SECURITY_JWT_ISSUER=hairddae

# Service identity
INFERENCE_APP_NAME=hairapply-inference
INFERENCE_HOST=0.0.0.0
INFERENCE_PORT=8090
INFERENCE_NODE_ID=infer-a-01

# WebSocket / protocol contract
INFERENCE_TICKET_AUDIENCE=inference
INFERENCE_FEATURE_SCHEMA_VERSION=2
INFERENCE_TRANSFORM_VERSION=affine_v1
INFERENCE_WS_PROTOCOL=hairapply.v2

# Runtime behavior
INFERENCE_PROCESSED_TIMEOUT_MS=250
INFERENCE_HEARTBEAT_INTERVAL_MS=5000
INFERENCE_IDLE_TTL_MS=30000
INFERENCE_HYSTERESIS_MARGIN=4.0
INFERENCE_MIN_HOLD_MS=400

# Static dataset
INFERENCE_STATIC_ROOT=/opt/be-static
INFERENCE_STATIC_BASE_URL=/static

# Redis
# Prefer INFERENCE_REDIS_URL if running standalone.
# For compose-based same-server deploy, REDIS_HOST/REDIS_PORT/REDIS_PASSWORD are enough.
INFERENCE_REDIS_URL=
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=change-me-for-real-deploy
