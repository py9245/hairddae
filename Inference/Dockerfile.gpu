FROM nvidia/cuda:12.4.1-cudnn-devel-ubuntu22.04 AS opencv-builder

ARG CUDA_ARCH_BIN=7.5
ARG OPENCV_PYTHON_REF=4.x
ARG OPENCV_CONTRIB_REF=4.x

ENV DEBIAN_FRONTEND=noninteractive \
    PIP_NO_CACHE_DIR=1

RUN apt-get update \
    && apt-get install -y --no-install-recommends \
        build-essential \
        ca-certificates \
        cmake \
        curl \
        git \
        ninja-build \
        pkg-config \
        python3 \
        python3-dev \
        python3-pip \
        python3-venv \
        python-is-python3 \
        libavcodec-dev \
        libavformat-dev \
        libegl1 \
        libgl1 \
        libglib2.0-0 \
        libgomp1 \
        libjpeg-dev \
        libpng-dev \
        libswscale-dev \
        libtbb-dev \
        libtiff-dev \
        libwebp-dev \
    && rm -rf /var/lib/apt/lists/*

RUN pip install --upgrade pip setuptools wheel scikit-build numpy

RUN git clone --branch "${OPENCV_PYTHON_REF}" --depth 1 https://github.com/opencv/opencv-python.git /tmp/opencv-python \
    && git clone --branch "${OPENCV_CONTRIB_REF}" --depth 1 https://github.com/opencv/opencv_contrib.git /tmp/opencv_contrib

WORKDIR /tmp/opencv-python

ENV ENABLE_HEADLESS=1 \
    ENABLE_CONTRIB=1 \
    CMAKE_ARGS="-DWITH_CUDA=ON -DWITH_CUDNN=ON -DOPENCV_DNN_CUDA=ON -DWITH_CUBLAS=ON -DCUDA_ARCH_BIN=${CUDA_ARCH_BIN} -DOPENCV_EXTRA_MODULES_PATH=/tmp/opencv_contrib/modules -DBUILD_opencv_cudacodec=OFF -DWITH_NVCUVID=OFF -DWITH_NVCUVENC=OFF -DBUILD_TESTS=OFF -DBUILD_PERF_TESTS=OFF -DBUILD_EXAMPLES=OFF"

RUN pip wheel . --verbose -w /tmp/wheels


FROM nvidia/cuda:12.4.1-cudnn-runtime-ubuntu22.04 AS runtime

ENV DEBIAN_FRONTEND=noninteractive \
    PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    UV_LINK_MODE=copy \
    MPLCONFIGDIR=/tmp/matplotlib \
    PATH="/root/.local/bin:${PATH}"

WORKDIR /app

RUN apt-get update \
    && apt-get install -y --no-install-recommends \
        ca-certificates \
        curl \
        libegl1 \
        libgl1 \
        libglib2.0-0 \
        libgomp1 \
        python3 \
        python3-pip \
        python3-venv \
        python-is-python3 \
    && rm -rf /var/lib/apt/lists/*

RUN pip install --no-cache-dir uv

COPY pyproject.toml uv.lock ./
RUN uv sync --no-dev --frozen

COPY --from=opencv-builder /tmp/wheels /tmp/wheels
RUN . /app/.venv/bin/activate \
    && pip uninstall -y opencv-python-headless opencv-contrib-python-headless \
    && pip install /tmp/wheels/opencv_contrib_python_headless-*.whl \
    && rm -rf /tmp/wheels

COPY app ./app
COPY models ./models

EXPOSE 8090

CMD ["uv", "run", "uvicorn", "app.main:create_app", "--factory", "--host", "0.0.0.0", "--port", "8090"]
